{
  "manifest_version": 2,
  "name": "SOGo Rules Assistant",
  "version": "0.2.1",
  "description": "Create SOGo-visible mail filter rules from selected Thunderbird messages.",
  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage",
    "https://*/*",
    "http://*/*"
  ],
  "browser_action": {
    "default_title": "SOGo Rules Assistant",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sogo-rules-assistant@kjkratz.local",
      "strict_min_version": "102.0",
      "update_url": "https://kjk-kjkmeg.github.io/thunderbird-sogo-rules/updates.json"
    }
  }
}
